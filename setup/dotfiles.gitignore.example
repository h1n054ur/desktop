# Safety net for the bare dotfiles repo. The paths file remains the allowlist.

# Conflict copies, backups and generated state
*.bak
*.bak-*
*.cachyos
*.sync-conflict-*
**/__pycache__/
**/.cache/
**/cache/
**/node_modules/
**/.venv/
**/venv/
**/.env
**/.env.*
!**/.env.example
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.lock
**/*.pid
**/*.sock

# Claude credentials, conversations and runtime state never belong in git
.claude.json
.claude.json.*
.claude/.credentials.json
.claude/.credentials.json.*
.claude/settings.local.json
.claude/projects/
.claude/history.jsonl
.claude/file-history/
.claude/sessions/
.claude/session-env/
.claude/daemon/
.claude/daemon*
.claude/jobs/
.claude/tasks/
.claude/state/
.claude/debug/
.claude/telemetry/
.claude/paste-cache/
.claude/shell-snapshots/
.claude/backups/
.claude/scratch*/
.claude/worktrees/
.claude/skills/.trash/

# OpenCode credentials, accounts, sessions, logs and project state
.config/opencode/secrets/
.config/opencode/service.json
.config/opencode/antigravity-accounts.json
.config/opencode/antigravity-signature-cache.json
.config/opencode/gemini-profiles.json
.config/opencode/profiles/
.config/opencode/projects/
.config/opencode/sessions/
.config/opencode/logs/
.config/opencode/project-settings-migration.json
.config/opencode/remote-url
.config/opencode/**/credentials.json
.config/opencode/**/tokens.json
.config/opencode/package.json
.config/opencode/package-lock.json
.config/opencode/bun.lock
.local/share/opencode/
.local/state/opencode/

# ~/.local/bin contains generated metadata and backup copies too
.local/bin/.muse-*
.local/bin/*.bak
.local/bin/*.bak-*
.local/bin/*.cachyos
