#!/usr/bin/env bash
# place: open, move or focus apps on screens and workspaces (Hyprland), for people and for the assistant.
#   place <app> [left|right|here|other|ws N]   open the app there, or move it there if it already runs
#   place left|right|other|ws N                move the focused window
#   place fullscreen|max                        fullscreen / maximise the focused window
#   place focus <app>                           jump to an app without moving it
#   place list                                  apps it can open (name -> window class)
# Screens: left = the left-most monitor (main), right = the other one; "here" = the focused one.
# Apps are found among open windows first (class or title), then in the .desktop files (Name=).
set -euo pipefail

die() { echo "place: $*" >&2; exit 1; }
dispatch() { if [ -n "${PLACE_DRY:-}" ]; then echo "DRY: $1"; else hyprctl dispatch "$1" >/dev/null; fi; }
lower() { tr '[:upper:]' '[:lower:]'; }

monitors() { hyprctl monitors -j; }
monitor_ws() {  # active workspace id of left|right|here|other
    local m; m=$(monitors)
    case "$1" in
        left)  jq -r 'sort_by(.x)|.[0].activeWorkspace.id' <<<"$m" ;;
        right) jq -r 'sort_by(.x)|.[-1].activeWorkspace.id' <<<"$m" ;;
        here)  jq -r '.[]|select(.focused)|.activeWorkspace.id' <<<"$m" ;;
        other) jq -r '(.[]|select(.focused)|.name) as $f | [.[]|select(.name!=$f)][0].activeWorkspace.id' <<<"$m" ;;
        *) die "unknown screen '$1' (left, right, here, other)" ;;
    esac
}
target_ws() {  # args: left|right|here|other | ws N
    if [ "${1:-here}" = ws ]; then
        [[ "${2:-}" =~ ^[0-9]+$ ]] || die "ws needs a number"
        echo "$2"
    else
        monitor_ws "${1:-here}"
    fi
}

find_window() {  # prints the address of the best open window for a query
    local q; q=$(lower <<<"$1")
    hyprctl clients -j | jq -r --arg q "$q" '
        [ .[] | select(.mapped) | . as $c
          | ($c.class|ascii_downcase) as $cl | ($c.title|ascii_downcase) as $t
          | if $cl == $q then {a:$c.address, s:0}
            elif ($cl|contains($q)) then {a:$c.address, s:1}
            elif ($t|contains($q)) then {a:$c.address, s:2}
            else empty end ]
        | sort_by(.s) | .[0].a // empty'
}

find_desktop() {  # prints "class<TAB>exec" for the best .desktop match
    local q; q=$(lower <<<"$1")
    local f name exec cls best="" bestscore=9
    while IFS= read -r f; do
        grep -qiE '^(NoDisplay|Hidden)=true' "$f" && continue
        name=$(grep -m1 '^Name=' "$f" | cut -d= -f2- | lower)
        local base; base=$(basename "$f" .desktop | lower)
        local score=9
        if [ "$name" = "$q" ] || [ "$base" = "$q" ]; then score=0
        elif [[ "$name" == "$q"* ]]; then score=1
        elif [[ "$name" == *"$q"* || "$base" == *"$q"* ]]; then score=2
        else continue; fi
        if [ "$score" -lt "$bestscore" ]; then bestscore=$score; best=$f; fi
    done < <(ls ~/.local/share/applications/*.desktop /usr/share/applications/*.desktop 2>/dev/null)
    [ -n "$best" ] || return 1
    exec=$(grep -m1 '^Exec=' "$best" | cut -d= -f2- | sed -E 's/ ?%[a-zA-Z]//g')
    cls=$(grep -m1 '^StartupWMClass=' "$best" | cut -d= -f2- || true)
    [ -n "$cls" ] || cls=$(basename "$best" .desktop)
    printf '%s\t%s\n' "$cls" "$exec"
}

move_to() {  # address workspace
    dispatch "hl.dsp.window.move({ workspace = '$2', window = 'address:$1' })"
    dispatch "hl.dsp.focus({ window = 'address:$1' })"
}

open_app() {  # query [where...]
    local q="$1"; shift
    local ws addr hit cls cmd
    ws=$(target_ws "$@")
    if addr=$(find_window "$q") && [ -n "$addr" ]; then
        move_to "$addr" "$ws"; echo "moved $q to workspace $ws"; return
    fi
    hit=$(find_desktop "$q") || die "no app or window matches '$q' (try: place list)"
    cls=${hit%%$'\t'*}; cmd=${hit#*$'\t'}
    local before; before=$(hyprctl clients -j | jq -r '.[].address' | sort)
    dispatch "hl.dsp.exec_cmd([==[uwsm app -- $cmd]==], { workspace = '$ws' })"
    # single-process apps (browsers, Electron) ignore the exec rule; catch the new window and move it
    for _ in $(seq 60); do
        sleep 0.1
        addr=$(comm -13 <(echo "$before") <(hyprctl clients -j | jq -r '.[].address' | sort) | head -1)
        if [ -n "$addr" ]; then move_to "$addr" "$ws"; echo "opened $q on workspace $ws"; return; fi
    done
    echo "started $q ($cls); its window did not appear within 6 s"
}

case "${1:-}" in
    ""|-h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    list)
        for f in ~/.local/share/applications/*.desktop /usr/share/applications/*.desktop; do
            grep -qiE '^(NoDisplay|Hidden)=true' "$f" && continue
            printf '%s -> %s\n' "$(grep -m1 '^Name=' "$f" | cut -d= -f2-)" \
                "$(grep -m1 '^StartupWMClass=' "$f" | cut -d= -f2- || basename "$f" .desktop)"
        done | sort -u ;;
    left|right|other|here|ws)
        addr=$(hyprctl activewindow -j | jq -r '.address // empty'); [ -n "$addr" ] || die "no focused window"
        ws=$(target_ws "$@"); move_to "$addr" "$ws"; echo "moved the focused window to workspace $ws" ;;
    fullscreen) dispatch "hl.dsp.window.fullscreen()"; echo "toggled fullscreen" ;;
    max) dispatch "hl.dsp.window.fullscreen({ mode = 1 })"; echo "toggled maximise" ;;
    focus)
        [ -n "${2:-}" ] || die "focus needs an app"
        addr=$(find_window "$2") && [ -n "$addr" ] || die "no open window matches '$2'"
        dispatch "hl.dsp.focus({ window = 'address:$addr' })"; echo "focused $2" ;;
    *) open_app "$@" ;;
esac
