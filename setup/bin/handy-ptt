#!/usr/bin/env bash
# Hold-to-talk for Handy on Wayland: `handy-ptt down` on key press, `handy-ptt up` on key release (Right Alt).
# Handy only offers a toggle (`handy --toggle-transcription`), so blind press/release toggles drift out of step
# whenever a release is missed or runs before its press. This checks whether Handy is really recording,
# by its live PipeWire capture stream (alsa_capture.handy, open only while recording), and only toggles when
# the state needs to change.
# After a stop it presses Enter once Handy has typed the text, but only into the assistant panel (Right Ctrl)
# or a kitty window running Claude Code, so dictated requests send themselves there and nowhere else.
set -u

recording() {
    pactl -f json list source-outputs 2>/dev/null |
        jq -e 'any(.[]; .properties["node.name"] == "alsa_capture.handy")' >/dev/null
}

wants_enter() {
    [ -e "${XDG_RUNTIME_DIR:-/tmp}/assistant-visible" ] && return 0
    # Claude Code puts a status symbol at the start of the terminal title (✳ idle, spinner frames while working)
    hyprctl activewindow -j 2>/dev/null |
        jq -e '.class == "kitty" and (.title | test("^[✳✶✻✽✢·◐◓◑◒] "))' >/dev/null
}

enter_after_paste() {  # waits for Handy to finish typing (or to give up), then presses Enter if wanted
    local log=$1 from=$2 line size
    for _ in $(seq 200); do
        sleep 0.1
        size=$(stat -c %s "$log" 2>/dev/null || echo 0)
        [ "$size" -lt "$from" ] && from=0   # Handy rolled its log over: read the new file from the start
        line=$(tail -c +"$((from + 1))" "$log" 2>/dev/null |
            grep -m1 -E 'Text pasted successfully|no audio samples|cancellation|Transcription result: *$')
        case "$line" in
            *"Text pasted successfully"*) if wants_enter; then wtype -k Return; log_event "pasted, Enter"; else log_event "pasted, no Enter"; fi; return ;;
            ?*) return ;;
        esac
    done
}

# Serialise down/up (a quick tap can start them out of order) and remember a start that is still opening:
# after a few idle minutes Handy reloads its model and its mic stream takes ~330 ms to appear, so an early
# release must wait for the recording to exist before stopping it, or it would be left listening.
run="${XDG_RUNTIME_DIR:-/tmp}"
starting="$run/handy-ptt-starting"
exec 9>"$run/handy-ptt.lock"
flock 9

log_event() { logger -t handy-ptt -- "$*"; }   # journalctl -t handy-ptt shows every key event and decision

wait_for() {  # wait_for yes|no: until recording() matches, at most 2 s
    for _ in $(seq 40); do
        if recording; then [ "$1" = yes ] && return 0; else [ "$1" = no ] && return 0; fi
        sleep 0.05
    done
    return 1
}

released="$run/handy-ptt-released"

case "${1:-}" in
    down)
        # its release already ran (the two processes can start out of order on a quick tap): nothing to do
        if [ -e "$released" ] && [ $(( $(date +%s%N) - $(cat "$released" 2>/dev/null || echo 0) )) -lt 1000000000 ]; then
            rm -f "$released"; log_event "down: its release already ran, not starting"; exit 0
        fi
        rm -f "$released"
        if recording; then log_event "down: already recording"; exit 0; fi
        : > "$starting"
        log_event "down: start"
        handy --toggle-transcription
        ;;
    up)
        if [ -e "$starting" ]; then
            rm -f "$starting"
            wait_for yes || { log_event "$1: start never appeared"; exit 0; }
        elif ! recording; then
            # a release before its press was handled: tell that press not to start
            date +%s%N > "$released"
            log_event "up: not recording, marked"
            exit 0
        fi
        recording || exit 0
        log=~/.local/share/com.pais.handy/logs/handy.log
        from=$(stat -c %s "$log" 2>/dev/null || echo 0)
        log_event "$1: stop"
        handy --toggle-transcription
        wait_for no || log_event "$1: still recording 2 s after stop"
        enter_after_paste "$log" "$from" 9>&- & disown
        ;;
    *) echo "usage: handy-ptt down|up" >&2; exit 2 ;;
esac
exit 0
