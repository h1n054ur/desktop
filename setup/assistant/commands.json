{
  "_doc": "Fast voice commands for handy-out. Order: (1) code rule 'open/switch to/bring up/put <app> [where]'; (2) patterns (regexes over the lowercased words, filler like 'please' removed); (3) Laya, the local decision model, picks by criteria and runs only at >= floor (0.7, from tests: Laya alone gets ~60% of phrasings right) or >= floor_with_app when code found the app; (4) anything else goes to the Haiku panel. {app}, {where}, {number} are read from the words by code. Keep risky things (Bluetooth, Wi-Fi, power, sending, deleting) out of here: Haiku asks first.",
  "floor": 0.7,
  "commands": [
    {
      "id": "media_toggle",
      "criteria": "pause, resume, play or stop the music or the video",
      "run": [
        "playerctl",
        "play-pause"
      ],
      "patterns": [
        "^(pause|play|resume|unpause|stop)( (it|that|this|the (music|song|video|track|audio)|music|some music|playback))?$",
        "^(hold on|wait)?,? ?(pause|stop) (it|that|this|the music|the video)$",
        "^(start|continue) (the )?(music|song|video|playing)$",
        "^(play|start|resume) (the |my )?(music|song|video) again$"
      ]
    },
    {
      "id": "media_next",
      "criteria": "skip to the next song or track",
      "run": [
        "playerctl",
        "next"
      ],
      "patterns": [
        "^(next|skip)( (song|track|one|this|it|this song|this track))?$",
        "^(play|go to) the next (song|track|one)$",
        "^skip (to the )?next( (song|track))?$"
      ]
    },
    {
      "id": "media_previous",
      "criteria": "go back to the previous song or track",
      "run": [
        "playerctl",
        "previous"
      ],
      "patterns": [
        "^(previous|last|prev)( (song|track|one))?$",
        "^(go )?back( a| one)? (song|track)$",
        "^(play|go to) the (previous|last) (song|track|one)$"
      ]
    },
    {
      "id": "volume_up",
      "criteria": "make the sound louder, turn the volume up",
      "run": [
        "noctalia",
        "msg",
        "volume-up"
      ],
      "patterns": [
        "^(louder|volume up|turn (it|that|the volume|the sound|the music) up( (a bit|a little|some|more))?|turn up (the )?(volume|sound|music)|crank it( up)?|(raise|increase) (the )?volume|make it louder|more volume)$"
      ]
    },
    {
      "id": "volume_down",
      "criteria": "make the sound quieter, turn the volume down",
      "run": [
        "noctalia",
        "msg",
        "volume-down"
      ],
      "patterns": [
        "^(quieter|softer|volume down|turn (it|that|the volume|the sound|the music) down( (a bit|a little|some))?|turn down (the )?(volume|sound|music)|(lower|reduce|decrease) (the )?volume|make it quieter|too loud|less volume)$",
        "^(it'?s |that'?s |this is |way )?(too|so) loud$"
      ]
    },
    {
      "id": "volume_mute",
      "criteria": "mute or unmute the sound",
      "run": [
        "noctalia",
        "msg",
        "volume-mute"
      ],
      "patterns": [
        "^(mute|unmute)( (it|the sound|the audio|the volume|sound|audio))?$",
        "^(turn|switch) (the )?sound (off|on)$"
      ]
    },
    {
      "id": "volume_set",
      "criteria": "set the volume to a given number or percent",
      "args": [
        "number"
      ],
      "run": [
        "noctalia",
        "msg",
        "volume-set",
        "{number}"
      ],
      "patterns": [
        "^(set |turn )?(the )?volume (to |at )?(\\d{1,3}|[a-z]+)( percent| %)?$",
        "^(set|turn) (it|the sound) to (\\d{1,3}|[a-z]+)( percent)?$"
      ]
    },
    {
      "id": "place_app",
      "criteria": "open a named app, or put or move a named app onto the left, right or other screen or onto a workspace",
      "args": [
        "app",
        "where"
      ],
      "run": [
        "place",
        "{app}",
        "{where}"
      ]
    },
    {
      "id": "move_window",
      "criteria": "move this window, the current window, to the left, right or other screen or to a workspace",
      "args": [
        "where"
      ],
      "run": [
        "place",
        "{where}"
      ],
      "patterns": [
        "^(move|send|put|throw|shift) (this|that|it|the window|this window)( window)? (to|on|onto) (the )?(other|left|right|main|second)( (screen|monitor|side|display))?$",
        "^(move|send|put|throw) (this|that|it|the window|this window)( window)? (to|on|onto) (workspace|desktop|space) (\\d+|[a-z]+)$",
        "^(move|send) (it|this|that) (left|right|over)$"
      ]
    },
    {
      "id": "focus_app",
      "criteria": "switch to, show or go to a named app without moving it",
      "args": [
        "app"
      ],
      "run": [
        "place",
        "focus",
        "{app}"
      ]
    },
    {
      "id": "fullscreen",
      "criteria": "make this window fullscreen, or leave fullscreen",
      "run": [
        "place",
        "fullscreen"
      ],
      "patterns": [
        "^(make (it|this|that)( window)? )?(full ?screen)( it)?$",
        "^(exit|leave|toggle|go|get out of) (full ?screen)$",
        "^(maximi[sz]e|max) (it|this|this window)$"
      ]
    },
    {
      "id": "workspace",
      "criteria": "go to or switch to workspace number N",
      "args": [
        "number"
      ],
      "run": [
        "hyprctl",
        "dispatch",
        "hl.dsp.focus({ workspace = '{number}' })"
      ],
      "patterns": [
        "^(go to|switch to|show|open|jump to)? ?(workspace|desktop|space) (\\d+|[a-z]+)$"
      ]
    },
    {
      "id": "screenshot",
      "criteria": "take a screenshot or screen capture",
      "run": [
        "noctalia",
        "msg",
        "screenshot-region"
      ],
      "patterns": [
        "^(take |grab |make )?(a )?(screenshot|screen ?shot|screen capture|screen grab)( (of this|of the screen|please))?$",
        "^capture (the |this )?screen$"
      ]
    },
    {
      "id": "dnd_toggle",
      "criteria": "turn do not disturb on or off, silence notifications",
      "run": [
        "noctalia",
        "msg",
        "notification-dnd-toggle"
      ],
      "patterns": [
        "^(turn |switch )?(on |off )?do not disturb( (on|off|mode))?$",
        "^(turn|switch) (off|on) (the )?notifications$",
        "^(silence|mute|stop) (the )?notifications$",
        "^dnd( (on|off))?$"
      ]
    },
    {
      "id": "nightlight_toggle",
      "criteria": "turn the night light or blue light filter on or off",
      "run": [
        "noctalia",
        "msg",
        "nightlight-toggle"
      ],
      "patterns": [
        "^(turn |switch )?(on |off )?(the )?(night ?light|night mode|blue light filter)( (on|off))?$"
      ]
    },
    {
      "id": "caffeine_toggle",
      "criteria": "keep the screen awake, or let it sleep again (caffeine)",
      "run": [
        "noctalia",
        "msg",
        "caffeine-toggle"
      ],
      "patterns": [
        "^(keep (the )?(screen|computer|pc|it) (awake|on)|don'?t (let it )?(sleep|go to sleep)|caffeine( (on|off))?|stay awake|let (it|the screen) sleep( again)?)$"
      ]
    },
    {
      "id": "wallpaper_next",
      "criteria": "change the wallpaper, next wallpaper",
      "run": [
        "noctalia",
        "msg",
        "wallpaper-next"
      ],
      "patterns": [
        "^(next|new|change|another|different|switch) (the )?(wallpaper|background)$",
        "^change (my )?(wallpaper|background)$"
      ]
    },
    {
      "id": "hide_panel",
      "criteria": "close or hide this assistant panel, never mind, that's all",
      "run": [
        "assistant",
        "hide"
      ],
      "patterns": [
        "^(never ?mind|close( this| it)?|hide( this| it)?|cancel|that'?s (all|it)|go away|nothing|forget it)$"
      ]
    }
  ],
  "aliases": {
    "youtube music": "YouTube Music",
    "yt music": "YouTube Music",
    "music app": "YouTube Music",
    "vs code": "VSCodium",
    "vscode": "VSCodium",
    "code editor": "VSCodium",
    "editor": "VSCodium",
    "browser": "Helium",
    "web browser": "Helium",
    "terminal": "kitty",
    "file manager": "Dolphin",
    "files app": "Dolphin",
    "ebook": "Foliate",
    "e-book": "Foliate",
    "camera": "Snapshot",
    "notes": "Notes (SilverBullet)",
    "teams": "Microsoft Teams",
    "pdf": "Stirling PDF"
  },
  "floor_with_app": 0.3
}
