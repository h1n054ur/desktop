#!/bin/sh
# speak-where: print the intro for a reply, or nothing when the reply's window is focused.
#
#   speak-where [--kitty-pid PID] [--kitty-window ID] --agent claude|opencode
#               [--voice NAME] [--model PROVIDER/MODEL] [--name NAME] [--project DIR]
#
# Focused (kitty reports the OS window focused, its tab active and the window active and focused,
# and under Hyprland the active window belongs to that kitty): prints nothing.
# Otherwise prints "Workspace <N>, <Label> in <project>." and when the workspace is unknown
# "<Label> in <project>." Always exits 0.
#
# The workspace is the one of the kitty OS window that holds the kitty window. One kitty process
# can own several OS windows, so the OS window comes from `kitten @ ls` and its title (the title of
# its active window) picks the Hyprland client among those owned by the kitty pid.
# Needs jq and kitty remote control on a socket: listen_on unix:@kitty-{kitty_pid}.

kpid="" wid="" agent="" voice="" model="" name="" project=""
while [ $# -gt 1 ]; do
  case $1 in
    --kitty-pid) kpid=$2 ;;
    --kitty-window) wid=$2 ;;
    --agent) agent=$2 ;;
    --voice) voice=$2 ;;
    --model) model=$2 ;;
    --name) name=$2 ;;
    --project) project=$2 ;;
    *) shift; continue ;;
  esac
  shift 2
done

# Who is talking. The one place that names the speaker: the name from the reply's label or the
# session's saved persona (--name, see `speak voice-from-reply`), else the agent.
label() {
  if [ -n "$name" ]; then
    printf '%s\n' "$name"
    return
  fi
  case $agent in
    claude) echo Claude ;;
    *)
      if [ -n "$voice" ] && [ "$voice" != default ]; then
        printf '%s\n' "$voice" | awk '{ print toupper(substr($0, 1, 1)) substr($0, 2) }'
      elif [ -n "$model" ]; then
        # Short model name: no provider, no date stamp, dashes read as spaces.
        printf '%s\n' "${model##*/}" | awk -F'[-_]' '{
          out = ""
          for (i = 1; i <= NF; i++) if ($i !~ /^[0-9]{6,}$/ && $i != "latest" && $i != "") out = out (out == "" ? "" : " ") $i
          print out
        }'
      else
        echo OpenCode
      fi
      ;;
  esac
}

who=$(label)
[ -n "$who" ] || who=OpenCode
folder=$(basename "${project:-$PWD}")
tail="$who in $folder."

say_unknown() {
  printf '%s\n' "$tail"
  exit 0
}

case $kpid in '' | *[!0-9]*) say_unknown ;; esac
case $wid in '' | *[!0-9]*) say_unknown ;; esac
command -v jq >/dev/null 2>&1 || say_unknown

# kitten is the fast Go client (about 30 ms), kitty @ starts Python (about 90 ms).
if command -v kitten >/dev/null 2>&1; then
  rc="kitten @"
elif command -v kitty >/dev/null 2>&1; then
  rc="kitty @"
else
  say_unknown
fi

# shellcheck disable=SC2086 # $rc is two words on purpose
lsjson=$(timeout 0.5 $rc --to "unix:@kitty-$kpid" ls 2>/dev/null) || say_unknown

# The OS window holding our window: is it focused, its title, how many OS windows kitty has.
info=$(printf '%s' "$lsjson" | jq -c --argjson w "$wid" '
  length as $count
  | [.[] | select(any(.tabs[].windows[]; .id == $w))] | .[0] // empty
  | . as $o
  | ([$o.tabs[] | select(.is_active == true)] | .[0]) as $t
  | {
      count: $count,
      title: (([$t.windows[]? | select(.is_active == true)] | .[0].title) // $t.title // ""),
      focused: ($o.is_focused == true and any($o.tabs[]; .is_active == true
        and any(.windows[]; .id == $w and .is_active == true and .is_focused == true)))
    }' 2>/dev/null)
[ -n "$info" ] || say_unknown

focused=$(printf '%s' "$info" | jq -r '.focused')

if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  [ "$focused" = true ] && exit 0
  say_unknown
fi

if [ "$focused" = true ]; then
  apid=$(timeout 0.5 hyprctl activewindow -j 2>/dev/null | jq -r '.pid // empty' 2>/dev/null)
  [ "$apid" = "$kpid" ] && exit 0
fi

# Workspace of the matching Hyprland client: the only client of a kitty with one OS window,
# else the one client of that pid whose title is the OS window's title. Anything else is unknown.
ws=$(timeout 0.5 hyprctl clients -j 2>/dev/null | jq -r --argjson p "$kpid" --argjson i "$info" '
  [.[] | select(.pid == $p)] as $mine
  | (if ($mine | length) == 1 and $i.count == 1 then $mine
     else [$mine[] | select(.title == $i.title)] end) as $hit
  | if ($hit | length) == 1 then ($hit[0].workspace.name // "") else "" end
' 2>/dev/null)
ws=${ws#special:}
[ -n "$ws" ] || say_unknown
printf 'Workspace %s, %s\n' "$ws" "$tail"
exit 0
