[Unit]
Description=Pocket TTS server for speak (local text to speech)
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/pocket-tts serve --host 127.0.0.1 --port 8777
Restart=on-failure
RestartSec=5
# Low priority so speech never slows the desktop.
Nice=10
CPUWeight=20
IOWeight=20
IOSchedulingClass=idle
# The model uses about 1 GB.
MemoryHigh=1536M
MemoryMax=2G

[Install]
WantedBy=default.target
