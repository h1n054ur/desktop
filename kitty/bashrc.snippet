# yazi: `y` opens it and cds to wherever you quit; zoxide gives `z <dir>` jumps; fzf adds Ctrl+T, Ctrl+R, Alt+C
function y() {
  local tmp cwd
  tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}
eval "$(zoxide init bash)"
eval "$(fzf --bash)"
