# Standalone cava (run `cava` in any kitty split); rmpc has its own built-in cava pane
[general]
framerate = 60
bar_width = 2
bar_spacing = 1

[input]
method = fifo
source = /tmp/mpd.fifo
sample_rate = 44100
sample_bits = 16

[output]
method = noncurses

[color]
gradient = 1
gradient_count = 3
gradient_color_1 = '#89b4fa'
gradient_color_2 = '#cba6f7'
gradient_color_3 = '#f5c2e7'

[smoothing]
noise_reduction = 77
