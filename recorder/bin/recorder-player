#!/usr/bin/env python3
"""recorder-player: play a recording in place for the library panel.

  recorder-player play FILE [FILE2]   start mpv (no video) and print one JSON line per change:
                                      {"pos": 12.3, "dur": 48.0, "paused": false}, then {"end": true}
  recorder-player pause               toggle pause on the running player
  recorder-player seek SECONDS        jump to an absolute position
  recorder-player stop                stop the running player

Two files (a system track and a mic track) play mixed together. Only one player runs at a
time: `play` stops any earlier one first. The panel runs `play` through noctalia.runStream,
so this process closes every inherited descriptor above 2 before anything else (a long-lived
child that keeps Noctalia's pipes open can stall the shell). Set RECORDER_PLAYER_AO=null to
play into no audio device (tests).
"""

import json
import os
import signal
import socket
import subprocess
import sys
import time

os.closerange(3, 65536)

POLL_S = 0.5


def sock_path():
    base = os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/recorder-{os.getuid()}"
    os.makedirs(base, exist_ok=True)
    return os.path.join(base, "recorder-player.sock")


def ipc(command, want_reply=False, timeout=1.0):
    """Send one mpv JSON IPC command. Returns the reply's data, or None."""
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(sock_path())
    except OSError:
        return None
    try:
        s.sendall((json.dumps({"command": command, "request_id": 1}) + "\n").encode())
        if not want_reply:
            return None
        buf = b""
        while True:
            chunk = s.recv(4096)
            if not chunk:
                return None
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                if msg.get("request_id") == 1:
                    return msg.get("data") if msg.get("error") == "success" else None
    except OSError:
        return None
    finally:
        s.close()


def emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def cmd_play(files):
    for f in files:
        if not os.path.isfile(f):
            emit({"error": f"no such file: {f}"})
            emit({"end": True})
            return 1
    ipc(["quit"])  # one player at a time
    path = sock_path()
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    argv = ["mpv", "--no-config", "--no-video", "--no-terminal", "--idle=no", "--keep-open=no", "--input-ipc-server=" + path,
            "--ao=" + os.environ.get("RECORDER_PLAYER_AO", "pipewire,pulse,alsa"), files[0]]
    if len(files) > 1:
        argv += ["--external-file=" + files[1], "--lavfi-complex=[aid1][aid2]amix=inputs=2[ao]"]
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL)

    def stop(_sig=None, _frm=None):
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(2)
            except subprocess.TimeoutExpired:
                proc.kill()
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, stop)
    signal.signal(signal.SIGINT, stop)
    last = None
    try:
        while proc.poll() is None:
            pos = ipc(["get_property", "time-pos"], True)
            dur = ipc(["get_property", "duration"], True)
            paused = ipc(["get_property", "pause"], True)
            if pos is not None and dur is not None:
                cur = {"pos": round(float(pos), 1), "dur": round(float(dur), 1), "paused": bool(paused)}
                if cur != last:
                    emit(cur)
                    last = cur
            time.sleep(POLL_S)
        emit({"end": True})
    except BrokenPipeError:
        stop()
    return 0


def main(argv):
    if len(argv) >= 2 and argv[0] == "play":
        return cmd_play(argv[1:3])
    if argv == ["pause"]:
        ipc(["cycle", "pause"])
        return 0
    if argv == ["stop"]:
        ipc(["quit"])
        return 0
    if len(argv) == 2 and argv[0] == "seek":
        try:
            ipc(["seek", float(argv[1]), "absolute"])
        except ValueError:
            print("seek takes seconds", file=sys.stderr)
            return 2
        return 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
